#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        del {
            bindings = <&kp DEL>;
            key-positions = <11 23>;
            layers = <0 1 2 3>;
        };

        mac_os {
            bindings = <&to 0>;
            key-positions = <16 15 17>;
            layers = <0 1 2 3>;
        };

        win_os {
            bindings = <&to 3>;
            key-positions = <27 28 29>;
            layers = <0 1 2 3>;
        };

        CAP {
            bindings = <&kp CAPSLOCK>;
            key-positions = <36 37>;
            layers = <0 1 2 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_os {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESC           &kp Q  &kp W  &kp E               &kp R           &kp T        &kp Y      &kp U            &kp I                           &kp O    &kp P          &kp BSPC
&mt LSHFT TAB     &kp A  &kp S  &kp D               &kp F           &kp G        &kp H      &kp J            &kp K                           &kp L    &kp SEMICOLON  &kp APOS
&kp LEFT_COMMAND  &kp Z  &kp X  &kp C               &kp V           &kp B        &kp N      &kp M            &kp COMMA                       &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                &mt LEFT_ALT LCTRL  &lt 1 LEFT_GUI  &kp SPACE    &kp ENTER  &lt 2 BACKSPACE  &mt (LC(LEFT_ARROW)) RC(RIGHT)
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp GRAVE  &kp N1           &kp N2     &kp N3    &kp N4          &kp N5             &kp N6            &kp N7             &kp N8     &kp N9                &kp N0                 &kp BSPC
&trans     &kp EXCLAMATION  &kp AT     &kp HASH  &kp DOLLAR      &kp PERCENT        &kp CARET         &kp AMPS           &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &kp EQUAL        &kp MINUS  &kp PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMI   &kp COLON             &kp BACKSLASH          &trans
                                       &trans    &trans          &trans             &trans            &trans             &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans  &trans          &kp UP            &trans      &trans  &trans
&bt BT_CLR      &trans        &trans        &trans        &trans        &kp A             &trans  &kp LEFT        &kp DOWN          &kp RIGHT   &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &studio_unlock    &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &bootloader
                                            &trans        &trans        &trans            &trans  &trans          &trans
            >;
        };

        win_os {
            bindings = <
&kp ESC           &kp Q  &kp W  &kp E                  &kp R           &kp T        &kp Y      &kp U            &kp I                                   &kp O    &kp P          &kp BSPC
&mt LSHFT TAB     &kp A  &kp S  &kp D                  &kp F           &kp G        &kp H      &kp J            &kp K                                   &kp L    &kp SEMICOLON  &kp APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C                  &kp V           &kp B        &kp N      &kp M            &kp COMMA                               &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                &mt LEFT_ALT LEFT_GUI  &lt 4 LEFT_GUI  &kp SPACE    &kp ENTER  &lt 5 BACKSPACE  &mt (RC(RG(LEFT_ARROW))) LC(LG(RIGHT))
            >;
        };

        lower_layer_win {
            bindings = <
&kp GRAVE  &kp N1           &kp N2     &kp N3    &kp N4          &kp N5             &kp N6            &kp N7             &kp N8     &kp N9                &kp N0                 &kp BSPC
&trans     &kp EXCLAMATION  &kp AT     &kp HASH  &kp DOLLAR      &kp PERCENT        &kp CARET         &kp AMPS           &kp ASTRK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&trans     &kp EQUAL        &kp MINUS  &kp PLUS  &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SEMI   &kp COLON             &kp BACKSLASH          &trans
                                       &trans    &trans          &trans             &trans            &trans             &trans
            >;
        };

        raise_layer_win {
            bindings = <
&trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &trans  &trans          &kp UP            &trans      &trans  &trans
&bt BT_CLR      &trans        &trans        &trans        &trans        &kp A             &trans  &kp LEFT        &kp DOWN          &kp RIGHT   &trans  &trans
&bt BT_CLR_ALL  &trans        &trans        &trans        &trans        &studio_unlock    &trans  &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT  &trans  &bootloader
                                            &trans        &trans        &trans            &trans  &trans          &trans
            >;
        };
        reserved_1 { status = "reserved"; };
        reserved_2 { status = "reserved"; };
        reserved_3 { status = "reserved"; };
        reserved_4 { status = "reserved"; };
        reserved_5 { status = "reserved"; };
        reserved_6 { status = "reserved"; };
        reserved_7 { status = "reserved"; };
        reserved_8 { status = "reserved"; };
        reserved_9 { status = "reserved"; };
    };
};
